# Use TEST keys only during development.
# Copy this file to .env.local and replace the dummy values.
# Never commit .env.local or any real secret. Only NEXT_PUBLIC_* may reach the browser.

# Public site origin. Not a secret. Used for links and Origin checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Supabase project URL and service-role key.
# The service-role key bypasses row level security. Never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=dummy_supabase_service_role_key_replace_me

# Server-only Razorpay TEST mode credentials.
# The Key Id is not a secret: Checkout needs it in the browser, and the server passes it in the booking response.
# The Key Secret and Webhook Secret must never reach the browser.
RAZORPAY_KEY_ID=rzp_test_dummykeyid000000
RAZORPAY_KEY_SECRET=dummy_razorpay_key_secret_replace_me
RAZORPAY_WEBHOOK_SECRET=dummy_razorpay_webhook_secret_replace_me

# Google Calendar OAuth (provisional choice). All server-only.
GOOGLE_CLIENT_ID=000000000000-dummy.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy_google_client_secret_replace_me
GOOGLE_REFRESH_TOKEN=dummy_google_refresh_token_replace_me
GOOGLE_CALENDAR_ID=primary

# Alternative only if calendar auth is switched to a service account. Leave unset for OAuth.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=dummy@example.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nDUMMY\n-----END PRIVATE KEY-----\n"

# Protects the hold-expiry route. Server-only.
CRON_SECRET=dummy_cron_secret_replace_me

# IANA timezone used to compute and display slots. Timestamps are stored in UTC.
BUSINESS_TIMEZONE=Asia/Kolkata
